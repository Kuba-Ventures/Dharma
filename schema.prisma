generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String               @id @default(cuid())
  email                    String               @unique
  emailVerified            DateTime?
  name                     String?
  firstName                String?
  image                    String?

  // Location (set during onboarding; seeds milestone library)
  homeCity                 String?
  homeCityLat              Float?
  homeCityLng              Float?
  timezone                 String?

  // Tone
  tone                     String               @default("Concise")
  toneProfile              String?
  toneExample              String?
  toneSummary              String?
  inferredSignOff          String?
  inferredIntro            String?

  // Scheduling
  schedulingEnabled        Boolean              @default(true)
  schedulingPreferences    String?

  // Onboarding + UI state
  onboardingStep           Int                  @default(0)
  onboardingCompletedAt    DateTime?
  dismissedTiles           String[]             @default([])

  // Progression
  tier                     String               @default("Apprentice")
  lastSeenTier             String?
  displayBadgeId           String?              // user-selected badge for avatar overlay
  cumulativeSecondsSaved   Int                  @default(0)
  nextNpsPromptAt          DateTime?

  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  googleCredential         GoogleCredential?
  microsoftCredential      MicrosoftCredential?
  appleCredential          AppleCredential?

  accounts                 Account[]
  sessions                 Session[]
  labels                   Label[]
  labelPreset              LabelPreset?
  labelMappings            LabelMapping[]
  classifiedThreads        ClassifiedThread[]
  usageEvents              UsageEvent[]

  meetingHours             MeetingHour[]
  userMilestones           UserMilestone[]
  userBadges               UserBadge[]
  signals                  Signal[]
  feedback                 Feedback[]
}

model GoogleCredential {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email        String   @unique
  accessToken  String
  refreshToken String
  expiresAt        DateTime
  gmailHistoryId   String?
  gmailWatchExpiry DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model MicrosoftCredential {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email        String
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Apple does not use OAuth — users generate an app-specific password at appleid.apple.com.
// The password is stored AES-256-GCM encrypted using APPLE_CREDENTIAL_ENCRYPTION_KEY.
model AppleCredential {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  appleId              String
  encryptedAppPassword String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Label {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  description  String      @default("")
  color        String      @default("#1D9E75")   // UI chip color — label-palette teal
  gmailLabelId String?                            // Gmail label resource ID
  enabled      Boolean     @default(true)
  order        Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  rules        LabelRule[]

  @@unique([userId, name])
}

model LabelRule {
  id        String   @id @default(cuid())
  labelId   String
  label     Label    @relation(fields: [labelId], references: [id], onDelete: Cascade)
  field     String   // "subject" | "from" | "body" | "to"
  operator  String   // "contains" | "not_contains" | "starts_with" | "is"
  value     String
  createdAt DateTime @default(now())
}

// ── NextAuth adapter models ───────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── Industry-preset labels (VC / PE / Legal / General) ─────────────────────

model LabelPreset {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  preset       String   // "VC" | "PE" | "Legal" | "General" | "Custom"
  enabled      Boolean  @default(false)
  // Only used when preset == "Custom":
  customName   String?  // e.g. "Kuba Ventures" — also used as Gmail label prefix
  customLabels Json?    // [{ shortName, colorKey, displayHex }]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model LabelMapping {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  labelName    String   // e.g. "Dharma/Portfolio"
  gmailLabelId String
  createdAt    DateTime @default(now())

  @@unique([userId, labelName])
}

model ClassifiedThread {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  threadId     String
  classifiedAt DateTime @default(now())

  @@unique([userId, threadId])
}

// ── Cost / usage tracking ──────────────────────────────────────────────────

model UsageEvent {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventType    String   // "classify" | "draft" | "tone_sync" | "schedule"
  model        String
  inputTokens  Int
  outputTokens Int
  costUsd      Float
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

// ── Meeting hours (Configuration → Scheduling card) ────────────────────────

model MeetingHour {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayOfWeek Int      // 0 = Sunday, 6 = Saturday
  hourStart Int      // 0–23 inclusive
  hourEnd   Int      // 1–24, exclusive upper bound
  createdAt DateTime @default(now())

  @@index([userId, dayOfWeek])
}

// ── Milestones (gamified progression tied to user's home city) ─────────────

model MilestoneDef {
  id            String   @id  // slug, e.g. "summit-mt-mitchell"
  category      String   // "peak" | "trail" | "city_to_city" | "cultural" | "regional" | "intro"
  title         String
  description   String
  threshold     Int?     // seconds saved required; null = always-on
  copyTemplate  String   // user-facing copy with {city}/{firstName} placeholders
  gradient      String   // CSS gradient stops for share-card background
  requiredCity  String?  // "Charlotte, NC" — null = universal, applies to all users
  createdAt     DateTime @default(now())

  userMilestones UserMilestone[]

  @@index([requiredCity])
}

model UserMilestone {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestoneId String
  milestone   MilestoneDef @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  achievedAt  DateTime     @default(now())
  sharedAt    DateTime?

  @@unique([userId, milestoneId])
  @@index([userId, achievedAt])
}

// ── Badges (identity allowlist + earned achievements) ──────────────────────

model BadgeDef {
  id          String   @id  // slug, e.g. "welcome-aboard"
  title       String
  description String
  kind        String   // "tier" | "achievement" | "allowlist"
  criteria    Json     // declarative rule consumed by badgeRules.ts
  createdAt   DateTime @default(now())

  userBadges UserBadge[]
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId   String
  badge     BadgeDef @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  awardedAt DateTime @default(now())

  @@unique([userId, badgeId])
  @@index([userId, awardedAt])
}

// ── Signals (scaffold for deal/term-sheet detection) ───────────────────────

model Signal {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String    // "deal_flow" | "term_sheet" | etc.
  payload   Json
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([userId, readAt])
}

// ── Feedback (inline button + NPS) ─────────────────────────────────────────

model Feedback {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String   // "feedback" | "nps"
  score     Int?     // 0–10 for NPS, null for free-form
  message   String?
  page      String?  // path that triggered the feedback
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
