generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String               @id @default(cuid())
  email                    String               @unique
  emailVerified            DateTime?
  name                     String?
  firstName                String?
  image                    String?

  // Location (set during onboarding; drives timezone-aware scheduling)
  homeCity                 String?
  homeCityLat              Float?
  homeCityLng              Float?
  timezone                 String?

  // Tone
  tone                     String               @default("Concise")
  toneProfile              String?
  toneExample              String?
  toneSummary              String?
  inferredSignOff          String?
  inferredIntro            String?

  // Scheduling
  schedulingEnabled        Boolean              @default(true)
  schedulingPreferences    String?

  // Onboarding + UI state
  onboardingStep           Int                  @default(0)
  onboardingCompletedAt    DateTime?
  onboardingFlow           String?              // 'v1' | 'v2' — pinned at onboarding entry; layouts route by this, not the ONBOARDING_V2 env flag
  role                     String?              // onboarding role key (see lib/rolePresets.ts); drives the derived label preset
  addonInstalledAt         DateTime?            // stamped on first GoogleBearer add-on call; drives the install-nudge state
  tourCompletedAt          DateTime?
  toursSeen                String[]             @default([])
  dismissedTiles           String[]             @default([])

  // Progression
  tier                     String               @default("Apprentice")
  lastSeenTier             String?
  displayBadgeId           String?              // user-selected badge for avatar overlay
  cumulativeSecondsSaved   Int                  @default(0)
  nextNpsPromptAt          DateTime?
  signalDetectionEnabled   Boolean              @default(true)

  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  googleCredential         GoogleCredential?
  microsoftCredential      MicrosoftCredential?
  appleCredential          AppleCredential?

  accounts                 Account[]
  sessions                 Session[]
  labels                   Label[]
  labelPreset              LabelPreset?
  labelMappings            LabelMapping[]
  classifiedThreads        ClassifiedThread[]
  learnedLabels            LearnedLabel[]
  usageEvents              UsageEvent[]

  meetingHours             MeetingHour[]
  userBadges               UserBadge[]
  signals                  Signal[]
  feedback                 Feedback[]
}

model GoogleCredential {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email        String   @unique
  accessToken  String
  refreshToken String
  expiresAt        DateTime
  gmailHistoryId   String?
  gmailWatchExpiry DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model MicrosoftCredential {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email        String
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Apple does not use OAuth — users generate an app-specific password at appleid.apple.com.
// The password is stored AES-256-GCM encrypted using APPLE_CREDENTIAL_ENCRYPTION_KEY.
model AppleCredential {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  appleId              String
  encryptedAppPassword String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Label {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  description  String      @default("")
  color        String      @default("#1D9E75")   // UI chip color — label-palette teal
  gmailLabelId String?                            // Gmail label resource ID
  enabled      Boolean     @default(true)
  order        Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  rules        LabelRule[]

  @@unique([userId, name])
}

model LabelRule {
  id        String   @id @default(cuid())
  labelId   String
  label     Label    @relation(fields: [labelId], references: [id], onDelete: Cascade)
  field     String   // "subject" | "from" | "body" | "to"
  operator  String   // "contains" | "not_contains" | "starts_with" | "is"
  value     String
  createdAt DateTime @default(now())
}

// ── NextAuth adapter models ───────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── Industry-preset labels (VC / PE / Legal / General) ─────────────────────

model LabelPreset {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  preset       String   // "VC" | "PE" | "Legal" | "General" | "Custom"
  enabled      Boolean  @default(false)
  // Catch-all label appended to every preset. When true, emails that match no
  // other label are tagged "Uncategorized" instead of going unlabeled. The
  // user can delete it (flips this false) and re-add it from the Labels card.
  uncategorizedEnabled Boolean @default(true)
  // Only used when preset == "Custom":
  customName   String?  // e.g. "Kuba Ventures" — also used as Gmail label prefix
  customLabels Json?    // [{ shortName, colorKey, displayHex }]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model LabelMapping {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  labelName    String   // e.g. "Dharma/Portfolio"
  gmailLabelId String
  createdAt    DateTime @default(now())

  @@unique([userId, labelName])
}

model ClassifiedThread {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  threadId     String
  labelName    String?  // e.g. "Dharma/VC/Deal-Flow"; null for pre-redesign rows
  draftCreated Boolean  @default(false) // set when a draft was generated for this thread
  classifiedAt DateTime @default(now())

  @@unique([userId, threadId])
  @@index([userId, labelName])
}

// ── Smart Labeling: learned sender→label associations (issue #120) ──────────
// When the user manually applies a label to an email, Dharma remembers the
// sender→label association and re-applies it to future mail from that sender.
// Two granularities per association:
//   - matchType "address": exact sender (e.g. "jim@yahoo.com") — applied to
//     the next matching message immediately (sampleCount starts at 1).
//   - matchType "domain":  whole domain (senderKey "@vercel.com") — applied
//     only once sampleCount crosses the promotion threshold, so a single stray
//     label doesn't tag an entire domain.
// gmailLabelId is captured at learn time (the label the user actually added),
// so applying a learned label needs no name→id re-resolution.
model LearnedLabel {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  senderKey    String   // lowercased address ("jim@yahoo.com") or "@domain"
  matchType    String   // "address" | "domain"
  labelName    String   // Gmail label display name (for dedup/UI)
  gmailLabelId String?  // Gmail label resource ID applied for this association
  sampleCount  Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, senderKey, labelName])
  @@index([userId, senderKey])
}

// ── Cost / usage tracking ──────────────────────────────────────────────────

model UsageEvent {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventType    String   // "classify" | "draft" | "tone_sync" | "schedule"
  model        String
  // Tone preset active when the event was generated. Only set for
  // eventType="draft" — null elsewhere. Powers the dashboard Tone tile.
  tone         String?
  inputTokens  Int
  outputTokens Int
  costUsd      Float
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

// ── Meeting hours (Configuration → Scheduling card) ────────────────────────

model MeetingHour {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayOfWeek Int      // 0 = Sunday, 6 = Saturday
  hourStart Int      // 0–23 inclusive
  hourEnd   Int      // 1–24, exclusive upper bound
  createdAt DateTime @default(now())

  @@index([userId, dayOfWeek])
}

// ── Badges (identity allowlist + earned achievements) ──────────────────────

model BadgeDef {
  id          String   @id  // slug, e.g. "welcome-aboard"
  title       String
  description String
  kind        String   // "tier" | "achievement" | "allowlist"
  criteria    Json     // declarative rule consumed by badgeRules.ts
  createdAt   DateTime @default(now())

  userBadges UserBadge[]
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId   String
  badge     BadgeDef @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  awardedAt DateTime @default(now())

  @@unique([userId, badgeId])
  @@index([userId, awardedAt])
}

// ── Signals (scaffold for deal/term-sheet detection) ───────────────────────

model Signal {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String    // "deal_flow" | "term_sheet" | "transaction"
  threadId  String?   // Gmail threadId; nullable for pre-producer rows
  payload   Json
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@unique([userId, threadId, kind])
  @@index([userId, readAt])
}

// ── Feedback (inline button + NPS) ─────────────────────────────────────────

model Feedback {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String   // "feedback" | "nps"
  score     Int?     // 0–10 for NPS, null for free-form
  message   String?
  page      String?  // path that triggered the feedback
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
